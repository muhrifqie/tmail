NODE_ENV=production
INGEST_KEY=CHANGE_ME_LONG_RANDOM
ADMIN_KEY=change-me-admin-key
# 0 = no auto-delete
INBOX_TTL_SEC=0
INBOUND_MAX_BYTES=5242880
SQLITE_PATH=/srv/tmail/data/tmail.sqlite
REDIS_URL=redis://127.0.0.1:6379
API_PORT=3100
PUBLIC_API_URL=
PUBLIC_IP=203.0.113.10
# shared MX target for multi-domain (mail-only extras point MX here)
MAIL_HOSTNAME=mail.example.com
CORS_ORIGIN=*
# durable — outside tar overwrite path (deploy excludes data/)
DOMAINS_PATH=/srv/tmail/data/domains.json
CATCHALL_CREATE=0
# admin lockout
ADMIN_MAX_FAILS=3
ADMIN_FAIL_WINDOW_SEC=900
ADMIN_BAN_TTL_SEC=86400
# optional: leave empty so FE uses same-origin /api via reverse proxy
# VITE_API_URL=
