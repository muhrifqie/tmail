NODE_ENV=development
INGEST_KEY=dev-ingest-key-change-me
ADMIN_KEY=change-me-admin-key
# 0 = no auto-delete (keep forever until manual purge)
INBOX_TTL_SEC=0
INBOUND_MAX_BYTES=5242880
SQLITE_PATH=./data/tmail.sqlite
REDIS_URL=redis://127.0.0.1:6379
API_PORT=3100
PUBLIC_API_URL=http://127.0.0.1:3100
PUBLIC_IP=
MAIL_HOSTNAME=
CORS_ORIGIN=http://127.0.0.1:5173
CATCHALL_CREATE=0
# admin lockout: wrong key N times → ban IP
ADMIN_MAX_FAILS=3
ADMIN_FAIL_WINDOW_SEC=900
ADMIN_BAN_TTL_SEC=86400
